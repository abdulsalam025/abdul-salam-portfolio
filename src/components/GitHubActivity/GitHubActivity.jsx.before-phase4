import { useState, useEffect } from "react";
import { motion } from "framer-motion";
import { Star, GitFork, Circle, ExternalLink, AlertCircle, CheckCircle2, BookOpen } from "lucide-react";
import "./GitHubActivity.css";

const GITHUB_USERNAME = "abdulsalam025";

export default function GitHubActivity() {
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [profile, setProfile] = useState(null);
  const [repos, setRepos] = useState([]);
  const [languages, setLanguages] = useState([]);

  useEffect(() => {
    const fetchGitHubData = async () => {
      try {
        // Fetch Profile
        const profileRes = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}`);
        if (!profileRes.ok) {
          if (profileRes.status === 403 || profileRes.status === 429) throw new Error("Rate limit");
          throw new Error("Unavailable");
        }
        const profileData = await profileRes.json();

        // Fetch Repos
        const reposRes = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=10`);
        if (!reposRes.ok) throw new Error("Unavailable");
        const reposData = await reposRes.json();

        // Process top 4 valid repos
        const displayRepos = reposData.filter(repo => !repo.fork).slice(0, 4);

        // Process languages across the latest 10 repos
        const langCounts = {};
        let totalLangs = 0;
        reposData.forEach(repo => {
          if (repo.language) {
            langCounts[repo.language] = (langCounts[repo.language] || 0) + 1;
            totalLangs++;
          }
        });

        const sortedLangs = Object.entries(langCounts)
          .map(([name, count]) => ({ name, percent: Math.round((count / totalLangs) * 100) }))
          .sort((a, b) => b.percent - a.percent)
          .slice(0, 3); // Top 3 languages

        setProfile(profileData);
        setRepos(displayRepos);
        setLanguages(sortedLangs);
        setError(null);
      } catch (err) {
        setError(err.message === "Rate limit" ? "API Rate limit reached." : "Unable to load public GitHub activity right now.");
      } finally {
        setLoading(false);
      }
    };

    fetchGitHubData();
  }, []);

  const languageColors = {
    JavaScript: "#f7df1e",
    Python: "#3572A5",
    HTML: "#e34c26",
    CSS: "#563d7c",
    Jupyter: "#DA5B0B",
    "C++": "#f34b7d",
    C: "#555555",
    Java: "#b07219"
  };

  return (
    <section className="section github-section" id="github">
      <div className="section-label">09 / GITHUB</div>
      <div className="section-heading">
        <h2>Building in <span className="gradient-text">Public.</span></h2>
        <p>Selected activity from my GitHub development workflow.</p>
      </div>

      <div className="gh-container">
        {loading ? (
          <div className="gh-skeleton-layout">
            <div className="gh-glass-panel skeleton-box profile-skeleton shimmer"></div>
            <div className="gh-glass-panel skeleton-box repos-skeleton shimmer"></div>
          </div>
        ) : error ? (
          <div className="gh-glass-panel gh-error-state">
            <AlertCircle size={40} className="gh-error-icon" />
            <h3>GITHUB DATA UNAVAILABLE</h3>
            <p>{error}</p>
            <a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank" rel="noopener noreferrer" className="glass-btn primary-button">
              VIEW GITHUB <ExternalLink size={18} />
            </a>
          </div>
        ) : (
          <div className="gh-grid">
            
            {/* LEFT: PROFILE & OVERVIEW */}
            <div className="gh-left-column">
              <div className="gh-glass-panel gh-profile-card">
                <div className="gh-profile-header">
                  <img src={profile.avatar_url} alt={`${profile.login} avatar`} className="gh-avatar" />
                  <div className="gh-profile-info">
                    <h4>{profile.name || profile.login}</h4>
                    <a href={profile.html_url} target="_blank" rel="noopener noreferrer">@{profile.login}</a>
                  </div>
                  <div className="gh-status">
                    <CheckCircle2 size={14} className="status-icon" /> CONNECTED
                  </div>
                </div>

                <div className="gh-stats-row">
                  <div className="gh-stat">
                    <span className="stat-value">{profile.public_repos}</span>
                    <span className="stat-label">REPOSITORIES</span>
                  </div>
                  <div className="gh-stat">
                    <span className="stat-value">{profile.followers}</span>
                    <span className="stat-label">FOLLOWERS</span>
                  </div>
                  <div className="gh-stat">
                    <span className="stat-value">{profile.following}</span>
                    <span className="stat-label">FOLLOWING</span>
                  </div>
                </div>

                {languages.length > 0 && (
                  <div className="gh-languages">
                    <span className="gh-mini-title">REPOSITORY LANGUAGE DISTRIBUTION</span>
                    <div className="gh-lang-bars">
                      {languages.map(lang => (
                        <div key={lang.name} className="gh-lang-item">
                          <div className="gh-lang-meta">
                            <span className="lang-name"><Circle size={10} fill={languageColors[lang.name] || "#00f0ff"} stroke="none" /> {lang.name}</span>
                            <span className="lang-pct">{lang.percent}%</span>
                          </div>
                          <div className="gh-lang-track">
                            <motion.div 
                              className="gh-lang-fill" 
                              initial={{ width: 0 }} 
                              whileInView={{ width: `${lang.percent}%` }} 
                              viewport={{ once: true }}
                              transition={{ duration: 1, ease: "easeOut" }}
                              style={{ background: languageColors[lang.name] || "var(--accent)" }}
                            />
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
                
                <a href={profile.html_url} target="_blank" rel="noopener noreferrer" className="gh-profile-btn">
                  VIEW FULL PROFILE <ExternalLink size={16} />
                </a>
              </div>
            </div>

            {/* RIGHT: FEATURED BUILDS */}
            <div className="gh-right-column">
              <span className="gh-mini-title" style={{ marginBottom: "15px", display: "block", color: "var(--accent)" }}>FEATURED BUILDS</span>
              <div className="gh-repo-grid">
                {repos.map(repo => (
                  <motion.a 
                    href={repo.html_url} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    className="gh-glass-panel gh-repo-card"
                    key={repo.id}
                    whileHover={{ scale: 1.01 }}
                    transition={{ duration: 0.2 }}
                  >
                    <div className="repo-header">
                      <h5><BookOpen size={18} className="repo-icon"/> {repo.name}</h5>
                    </div>
                    <p className="repo-desc">{repo.description || "No description provided."}</p>
                    
                    <div className="repo-footer">
                      <div className="repo-meta-group">
                        {repo.language && (
                          <span className="repo-meta"><Circle size={10} fill={languageColors[repo.language] || "#00f0ff"} stroke="none" /> {repo.language}</span>
                        )}
                        <span className="repo-meta"><Star size={14} /> {repo.stargazers_count}</span>
                        <span className="repo-meta"><GitFork size={14} /> {repo.forks_count}</span>
                      </div>
                      <span className="repo-update">Updated {new Date(repo.updated_at).toLocaleDateString()}</span>
                    </div>
                  </motion.a>
                ))}
              </div>
            </div>

          </div>
        )}
      </div>
    </section>
  );
}




