.esn {
  position: fixed;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 40;
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 10px 8px 10px 14px;
  max-height: 78vh;
  overflow: visible;
  background: rgba(4, 12, 24, 0.45);
  border: 1px solid rgba(127, 220, 255, 0.12);
  border-radius: 18px;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.28);
}

.esn-track {
  position: absolute;
  left: 22px;
  top: 18px;
  bottom: 18px;
  width: 1px;
  background: rgba(127, 220, 255, 0.14);
  pointer-events: none;
}

.esn-track i {
  display: block;
  width: 100%;
  background: linear-gradient(180deg, #2ee6ff, #7a5cff);
  box-shadow: 0 0 8px rgba(46, 230, 255, 0.55);
  transition: height 0.25s ease;
}

.esn-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  border: 0;
  background: transparent;
  color: rgba(200, 214, 224, 0.55);
  cursor: pointer;
  padding: 6px 8px;
  border-radius: 999px;
  min-height: 28px;
  width: max-content;
  max-width: 36px;
  overflow: hidden;
  transition: max-width 0.22s ease, color 0.2s ease, background 0.2s ease;
}

.esn-item:hover,
.esn-item:focus-visible {
  max-width: 220px;
  color: #e8eef7;
  background: rgba(255, 255, 255, 0.04);
  outline: none;
}

.esn-item.is-on {
  max-width: 220px;
  color: #7af3ff;
  background: rgba(46, 230, 255, 0.12);
  box-shadow: inset 0 0 0 1px rgba(46, 230, 255, 0.28);
}

.esn-dot {
  flex: 0 0 auto;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: rgba(127, 220, 255, 0.28);
  box-shadow: 0 0 0 3px rgba(4, 12, 24, 0.9);
}

.esn-item.is-on .esn-dot {
  background: #2ee6ff;
  box-shadow: 0 0 0 3px rgba(4, 12, 24, 0.9), 0 0 10px rgba(46, 230, 255, 0.8);
}

.esn-num {
  flex: 0 0 auto;
  width: 22px;
  font-family: "Fira Code", ui-monospace, monospace;
  font-size: 0.68rem;
  letter-spacing: 0.08em;
}

.esn-label {
  white-space: nowrap;
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 700;
}

@media (max-width: 1100px) {
  .esn {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .esn-item,
  .esn-track i {
    transition: none;
  }
}