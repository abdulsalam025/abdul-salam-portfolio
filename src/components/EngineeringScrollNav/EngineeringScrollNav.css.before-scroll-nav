.esn { position: fixed; right: 18px; top: 50%; transform: translateY(-50%); z-index: 40; display: flex; flex-direction: column; gap: 6px; max-height: 72vh; overflow: auto; padding: 8px 6px; }
.esn-item { display: flex; align-items: center; gap: 8px; border: 0; background: transparent; color: #7f8f9a; cursor: pointer; padding: 3px 6px; border-radius: 999px; max-width: 42px; overflow: hidden; transition: max-width 0.25s ease, color 0.2s ease, background 0.2s ease; }
.esn-item:hover, .esn-item:focus-visible { max-width: 180px; color: #e8eef7; }
.esn-item.is-on { max-width: 180px; color: #7af3ff; background: rgba(46, 230, 255, 0.08); }
.esn-num { flex: 0 0 auto; width: 28px; font-size: 0.68rem; letter-spacing: 0.08em; }
.esn-label { white-space: nowrap; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; }
@media (max-width: 1024px) { .esn { display: none; } }