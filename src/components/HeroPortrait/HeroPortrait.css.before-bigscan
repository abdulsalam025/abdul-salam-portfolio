.hp { width: min(340px, 100%); margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 16px; }
.hp-stage { position: relative; width: 260px; height: 260px; }
.hp-halo {
  position: absolute; inset: -14px; border-radius: 50%;
  background: conic-gradient(from 200deg, transparent 0 62%, rgba(46, 230, 255, 0.4) 72%, transparent 88%);
  animation: hpSweep 10s linear infinite;
  mask: radial-gradient(circle, transparent 61%, #000 62%);
  -webkit-mask: radial-gradient(circle, transparent 61%, #000 62%);
  pointer-events: none;
}
.hp-disc {
  position: absolute; inset: 12px; border-radius: 50%; overflow: hidden; background: #0b1220;
  box-shadow: 0 22px 44px rgba(0, 0, 0, 0.38);
}
.hp-disc img, .hp-scan { position: absolute; inset: 0; width: 100%; height: 100%; }
.hp-disc img { object-fit: cover; display: block; }
.hp-scan { opacity: 0; transition: opacity 0.18s ease; pointer-events: none; }
.hp-hud {
  position: absolute; right: -4px; bottom: -6px; margin: 0;
  font: 700 0.58rem/1 "Fira Code", ui-monospace, monospace;
  letter-spacing: 0.16em; color: rgba(122, 243, 255, 0.7);
}
.hp-meta {
  display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap;
  font: 700 0.72rem/1 Inter, system-ui, sans-serif; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--text-secondary);
}
.hp-live { display: inline-flex; align-items: center; gap: 7px; color: var(--text-primary); }
.hp-live i { width: 7px; height: 7px; border-radius: 50%; background: #2ee6ff; box-shadow: 0 0 8px #2ee6ff; }
.hp-sep { width: 3px; height: 3px; border-radius: 50%; background: rgba(127, 220, 255, 0.45); }
.hp-meta a { color: var(--accent); text-decoration: none; }
.hp-meta a:hover { text-decoration: underline; }
@media (max-width: 900px) { .hp-stage { width: 210px; height: 210px; } }
@media (prefers-reduced-motion: reduce) { .hp-halo { animation: none; } .hp-scan { display: none; } }
.hp.is-still .hp-halo { animation: none; }
.hp.is-still .hp-scan { display: none; }
@keyframes hpSweep { to { transform: rotate(360deg); } }