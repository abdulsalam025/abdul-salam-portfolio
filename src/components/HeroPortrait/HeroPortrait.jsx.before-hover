import { useRef } from "react";
import "./HeroPortrait.css";

export default function HeroPortrait({ alt }) {
  const frame = useRef(null);

  const onMove = (event) => {
    const node = frame.current;
    if (!node) return;
    const box = node.getBoundingClientRect();
    const x = ((event.clientX - box.left) / box.width) * 100;
    const y = ((event.clientY - box.top) / box.height) * 100;
    node.style.setProperty("--mx", x + "%");
    node.style.setProperty("--my", y + "%");
    node.classList.add("is-scan");
  };

  return (
    <div className="hp">
      <div
        className="hp-frame"
        ref={frame}
        onMouseMove={onMove}
        onMouseLeave={() => frame.current && frame.current.classList.remove("is-scan")}
      >
        <img className="hp-photo" src="/hero-portrait.jpg" alt={alt || "Abdul Salam"} />
        <img className="hp-scan" src="/hero-scan.jpg" alt="" />
      </div>
      <div className="hp-meta">
        <span className="hp-live"><i />Online</span>
        <span className="hp-sep" aria-hidden="true" />
        <span>BE AI & ML</span>
        <span className="hp-sep" aria-hidden="true" />
        <a href="#ailab">Lab</a>
      </div>
    </div>
  );
}