.hero {
  max-width: 1520px;
  grid-template-columns: 0.78fr 1.32fr;
  gap: 0.6rem 1rem;
}

.hero-visual {
  width: 100%;
  max-width: none;
  justify-self: end;
  align-self: center;
}

.hp {
  width: min(980px, 100%);
  margin: 0;
  margin-left: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.hp-frame {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: visible;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.hp-photo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center bottom;
  display: block;
  filter: drop-shadow(0 28px 56px rgba(0, 240, 255, 0.2));
}

.hp-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
  font: 700 0.72rem/1 Inter, system-ui, sans-serif;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-secondary);
}

.hp-live {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--text-primary);
}

.hp-live i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #2ee6ff;
  box-shadow: 0 0 8px #2ee6ff;
}

.hp-sep {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: rgba(127, 220, 255, 0.45);
}

.hp-meta a {
  color: var(--accent);
  text-decoration: none;
}

.hp-meta a:hover {
  text-decoration: underline;
}

@media (max-width: 900px) {
  .hero {
    grid-template-columns: 1fr;
    max-width: 1200px;
  }
  .hero-visual {
    justify-self: center;
    width: min(92vw, 560px);
  }
  .hp {
    width: 100%;
    margin: 0 auto;
  }
}