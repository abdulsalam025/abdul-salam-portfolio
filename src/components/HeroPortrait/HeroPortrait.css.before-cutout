.hp {
  width: min(560px, 100%);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
}

.hp-frame {
  --mx: 50%;
  --my: 42%;
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  max-height: min(82vh, 680px);
  overflow: hidden;
  border-radius: 24px;
  background: #d9d9de;
  box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
}

.hp-photo,
.hp-scan {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 52% 40%;
  display: block;
}

.hp-scan {
  opacity: 0;
  pointer-events: none;
  -webkit-mask-image: radial-gradient(circle 340px at var(--mx) var(--my), #000 0%, transparent 72%);
  mask-image: radial-gradient(circle 340px at var(--mx) var(--my), #000 0%, transparent 72%);
  transition: opacity 0.16s ease;
}

.hp-frame.is-scan .hp-scan {
  opacity: 1;
}

.hp-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
  font: 700 0.72rem/1 Inter, system-ui, sans-serif;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-secondary);
}

.hp-live {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--text-primary);
}

.hp-live i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #2ee6ff;
  box-shadow: 0 0 8px #2ee6ff;
}

.hp-sep {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: rgba(127, 220, 255, 0.45);
}

.hp-meta a {
  color: var(--accent);
  text-decoration: none;
}

.hp-meta a:hover {
  text-decoration: underline;
}

@media (max-width: 900px) {
  .hp { width: min(360px, 92vw); }
  .hp-scan {
    -webkit-mask-image: radial-gradient(circle 210px at var(--mx) var(--my), #000 0%, transparent 72%);
    mask-image: radial-gradient(circle 210px at var(--mx) var(--my), #000 0%, transparent 72%);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hp-scan { display: none; }
}