.hp {
  width: min(340px, 100%);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18px;
}
.hp-stage {
  position: relative;
  width: 260px;
  height: 260px;
  transition: transform 0.2s ease-out;
}
.hp-halo {
  position: absolute;
  inset: -18px;
  border-radius: 50%;
  background: conic-gradient(from 180deg, transparent 0%, rgba(46, 230, 255, 0.55) 18%, transparent 38%, transparent 100%);
  animation: hpSweep 9s linear infinite;
  mask: radial-gradient(circle, transparent 58%, #000 59%);
  -webkit-mask: radial-gradient(circle, transparent 58%, #000 59%);
  pointer-events: none;
}
.hp-orbit {
  position: absolute;
  inset: -10px;
  border-radius: 50%;
  border: 1px solid rgba(127, 220, 255, 0.16);
  animation: hpSpin 18s linear infinite;
  pointer-events: none;
}
.hp-orbit span {
  position: absolute;
  top: 10%;
  left: 50%;
  width: 7px;
  height: 7px;
  margin-left: -3.5px;
  border-radius: 50%;
  background: #2ee6ff;
  box-shadow: 0 0 12px #2ee6ff;
}
.hp-disc {
  position: absolute;
  inset: 18px;
  border-radius: 50%;
  padding: 5px;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.55), rgba(46, 230, 255, 0.2) 40%, rgba(255, 255, 255, 0.05));
  box-shadow: 0 24px 50px rgba(0, 0, 0, 0.35);
}
.hp-disc img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
  background: #0b1220;
}
.hp-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
  font: 700 0.72rem/1 Inter, system-ui, sans-serif;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-secondary);
}
.hp-live { display: inline-flex; align-items: center; gap: 7px; color: var(--text-primary); }
.hp-live i {
  width: 7px; height: 7px; border-radius: 50%;
  background: #2ee6ff; box-shadow: 0 0 8px #2ee6ff;
}
.hp-sep { width: 3px; height: 3px; border-radius: 50%; background: rgba(127, 220, 255, 0.45); }
.hp-meta a { color: var(--accent); text-decoration: none; }
.hp-meta a:hover { text-decoration: underline; }
@media (max-width: 900px) {
  .hp-stage { width: 210px; height: 210px; }
}
@media (prefers-reduced-motion: reduce) {
  .hp-halo, .hp-orbit { animation: none; }
  .hp-stage { transition: none; }
}
.hp.is-still .hp-halo,
.hp.is-still .hp-orbit { animation: none; }
@keyframes hpSweep { to { transform: rotate(360deg); } }
@keyframes hpSpin { to { transform: rotate(360deg); } }