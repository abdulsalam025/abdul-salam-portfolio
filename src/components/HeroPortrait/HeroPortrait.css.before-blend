.hero {
  max-width: 1520px;
  grid-template-columns: 0.78fr 1.32fr;
  gap: 0.6rem 1rem;
}
.hero-visual { width: 100%; max-width: none; justify-self: end; }
.hp {
  width: min(980px, 100%);
  margin: 0 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}
.hp-frame {
  --mx: 50%;
  --my: 38%;
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: visible;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  cursor: crosshair;
}
.hp-photo, .hp-scan {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center bottom;
  display: block;
  pointer-events: none;
  background: transparent;
  filter: drop-shadow(0 18px 40px rgba(0, 0, 0, 0.45));
}
.hp-scan {
  opacity: 0 !important;
  visibility: hidden;
  -webkit-mask-image: radial-gradient(circle 220px at var(--mx) var(--my), #000 0%, #000 40%, transparent 70%);
  mask-image: radial-gradient(circle 220px at var(--mx) var(--my), #000 0%, #000 40%, transparent 70%);
}
.hp-frame.is-scan .hp-scan {
  opacity: 1 !important;
  visibility: visible;
}
.hp-meta {
  display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap;
  font: 700 0.72rem/1 Inter, system-ui, sans-serif; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--text-secondary);
}
.hp-live { display: inline-flex; align-items: center; gap: 7px; color: var(--text-primary); }
.hp-live i { width: 7px; height: 7px; border-radius: 50%; background: #2ee6ff; box-shadow: 0 0 8px #2ee6ff; }
.hp-sep { width: 3px; height: 3px; border-radius: 50%; background: rgba(127, 220, 255, 0.45); }
.hp-meta a { color: var(--accent); text-decoration: none; }
@media (max-width: 900px) {
  .hero { grid-template-columns: 1fr; }
  .hero-visual { justify-self: center; width: min(92vw, 560px); }
  .hp { width: 100%; margin: 0 auto; }
}